# Claude Code OAuth token — run `claude setup-token` on the host (not in the container).
# Uses your Claude subscription instead of API billing.
CLAUDE_CODE_OAUTH_TOKEN=
# Or an Anthropic API key instead:
# ANTHROPIC_API_KEY=
# Fine-grained GitHub token limited to harry0802/DeskDog.
# Repository permissions: Issues (Read and write), Metadata (Read). Nothing else.
GH_TOKEN=
